{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@dominio/*": [
        "../lib/dominio/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../lib/dominio/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../lib/dominio/**/*.test.ts"
  ]
}

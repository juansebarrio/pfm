{
  "expo": {
    "name": "Fin de mes",
    "slug": "fin-de-mes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icono.png",
    "scheme": "findemes",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141312",
    "primaryColor": "#1E6E52",
    "ios": {
      "bundleIdentifier": "com.juansebarrio.findemes",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Fin de mes",
        "CFBundleLocalizations": [
          "es-AR"
        ],
        "CFBundleDevelopmentRegion": "es-AR"
      }
    },
    "locales": {
      "es": "./locales/es.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E6E52",
          "image": "./assets/images/marca-splash.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Fin de mes usa Face ID para que solo vos veas tus números."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E6E52"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fin de mes accede a tus fotos para leer comprobantes que elijas. La imagen se lee y se descarta: no se guarda.",
          "cameraPermission": "Fin de mes usa la cámara para que saques la foto de un comprobante. La imagen se lee y se descarta: no se guarda."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}

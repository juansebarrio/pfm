{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pfm-mu.vercel.app",
        "EXPO_PUBLIC_DEMO": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pfm-mu.vercel.app",
        "EXPO_PUBLIC_DEMO": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pfm-mu.vercel.app",
        "EXPO_PUBLIC_DEMO": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
